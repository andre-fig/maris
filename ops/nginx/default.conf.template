server {
  listen ${PUBLIC_PORT};
  server_name _;
  client_max_body_size 256m;

  location = /tiles/soundg.json {
    proxy_pass http://127.0.0.1:3001;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }

  # Compatibility URL used by the current TileJSON. Nginx reads immutable
  # artifacts directly from the mounted storage; this request never reaches Nest.
  location ~ ^/tiles/soundg/(?<chart_version>[A-Za-z0-9_-]+)/(?<chart_z>[0-9]|1[0-6])/(?<chart_x>[0-9]+)/(?<chart_y>[0-9]+)\.pbf$ {
    # Only completed, immutable artifacts have a manifest. Unknown versions
    # must remain real, non-cacheable errors, not successful empty tiles.
    error_page 404 = @chart_not_found;
    if (!-f /app/.storage/chart-data/soundg/versions/$chart_version/manifest.json) { return 404; }
    rewrite ^ /chart-data/soundg/versions/$chart_version/$chart_z/$chart_x/$chart_y.pbf break;
    root /app/.storage;
    try_files $uri @empty_chart_tile;
    default_type application/vnd.mapbox-vector-tile;
    add_header Cache-Control "public, max-age=31536000, immutable";
    etag on;
  }

  location @empty_chart_tile {
    default_type application/vnd.mapbox-vector-tile;
    add_header Cache-Control "public, max-age=31536000, immutable";
    return 204;
  }

  location @chart_not_found {
    add_header Cache-Control "no-store" always;
    return 404;
  }

  location /tiles/soundg/ {
    add_header Cache-Control "no-store" always;
    return 404;
  }

  location / {
    proxy_pass http://127.0.0.1:3001;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }
}
