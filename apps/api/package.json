    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@types/express": "^5.0.3",
    "@types/multer": "2.2.0",
    "@types/node": "^22.18.6",
    "@types/pg": "8.15.5",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "3.4.0",
