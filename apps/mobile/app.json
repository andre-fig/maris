{
  "expo": {
    "name": "Maris",
    "slug": "maris",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/app-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.maris.navigation"
    },
    "android": {
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#064CA0"
      },
      "package": "com.maris.navigation"
    },
    "plugins": [
      "@maplibre/maplibre-react-native"
    ]
  }
}
