{
  "name": "maris",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev:api": "pnpm --filter @maris/api dev",
    "dev:mobile": "pnpm --filter @maris/mobile start",
    "ios": "pnpm --filter @maris/mobile ios",
    "android": "pnpm --filter @maris/mobile android",
    "build": "pnpm --filter @maris/api build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test"
  }
}
